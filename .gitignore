# OS / editor junk
.DS_Store
Thumbs.db
*.swp

# Secrets
.env
.env.*

# Database state — local only, never committed
state/*
!state/.gitkeep

# markdown-vault-mcp local index (each clone builds its own)
.mvmcp/

# Common build artifacts (fullstack template)
node_modules/
__pycache__/
.venv/
dist/
*.log

# Claude Code session scratch (per-session dedup state, locks)
.claude/.nudge-seen-*
.claude/*.lock
.claude/.graph-index-marker
